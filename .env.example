# Database
DB_URL=jdbc:postgresql://localhost:5432/manajemen_risiko
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Application and upstream service
SERVER_PORT=8080
PENETAPAN_API_URL=https://penetapan-service-staging.zeabur.app
SWAGGER_SERVER_URL=http://localhost:8080/manrisk/api

# Generate AI (OpenRouter)
# Keep disabled until OPENROUTER_API_KEY and the shared internal token are set.
MANRISK_AI_ENABLED=false
# Must exactly match RISIKO_AI_INTERNAL_TOKEN in the Next.js frontend.
RISIKO_AI_INTERNAL_TOKEN=replace_with_a_long_random_shared_token
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional safeguards; the defaults below match application.yml.
MANRISK_AI_RATE_LIMIT_PER_MINUTE=5
MANRISK_AI_MAX_CONCURRENT_REQUESTS=5
MANRISK_AI_CONNECT_TIMEOUT_SECONDS=3
MANRISK_AI_REQUEST_TIMEOUT_SECONDS=45
MANRISK_AI_PROVIDER_TIMEOUT_SECONDS=30
